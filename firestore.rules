rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'sankalpsmn@gmail.com' && request.auth.token.email_verified == true;
    }

    function isAdmin() { 
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.status == 'active'
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }

    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 1500000)
        && (data.get('description', '') is string && data.get('description', '').size() <= 2000)
        && (data.get('category', '') is string && data.get('category', '').size() <= 100)
        && (data.get('createdAt', request.time) is timestamp)
        && (data.get('updatedAt', request.time) is timestamp);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['productId', 'userName', 'comment', 'rating', 'createdAt'])
        && data.productId is string && data.productId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.comment is string && data.comment.size() <= 1000
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.createdAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'status', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.role in ['super_admin', 'admin']
        && data.status in ['active', 'disabled']
        && data.createdAt is timestamp;
    }

    function isValidUserImage(data) {
      return data.get('userId', '') is string && data.get('userId', '').size() <= 128
        && data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 1500000
        && data.get('publicId', '') is string && data.get('publicId', '').size() <= 500
        && data.get('createdAt', request.time) is timestamp;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().get('createdAt', request.time) == request.time && incoming().get('updatedAt', request.time) == request.time;
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().get('createdAt', request.time) == existing().get('createdAt', request.time) && incoming().get('updatedAt', request.time) == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'imageUrl', 'description', 'category', 'updatedAt', 'code', 'sizes', 'colors', 'fabric', 'deliveryTime', 'offerPercent', 'customMessage', 'stockStatus', 'badge', 'videoUrl', 'publicId', 'imageUrls', 'publicIds', 'peopleInterested', 'views']);
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isValidId(feedbackId) && isValidFeedback(incoming()) && incoming().createdAt == request.time;
      allow update: if false; // Feedback is usually immutable once posted
      allow delete: if isAdmin();
    }

    match /admins/{email} {
      allow get: if isSignedIn() && (request.auth.token.email.lower() == email || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidAdmin(incoming()) && incoming().createdAt == (resource == null ? request.time : resource.data.createdAt);
      allow delete: if isSuperAdmin() && email != 'sankalpsmn@gmail.com';
    }

    match /user_images/{imageId} {
      allow read: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isSignedIn() && isValidId(imageId) && isValidUserImage(incoming()) && incoming().get('userId', '') == request.auth.uid && incoming().get('createdAt', request.time) == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }
  }
}
