rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPERS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For this app, any authenticated user is an admin
      // In a production app, we would check a specific /admins collection
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // VALIDATION HELPERS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'imageUrl', 'createdAt', 'updatedAt']) 
        && data.name is string && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.imageUrl is string && data.imageUrl.size() <= 2000
        && data.description is string && data.description.size() <= 1000
        && (data.category == null || (data.category is string && data.category.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true; // Customers can browse products
      
      allow create: if isAdmin() 
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isAdmin()
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'imageUrl', 'description', 'category', 'updatedAt']);
        
      allow delete: if isAdmin();
    }
  }
}
