{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "enum": ["super_admin", "admin"], "description": "Access level" },
        "status": { "type": "string", "enum": ["active", "disabled"], "description": "Account status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "status", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback for a specific product",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID of the product this feedback is for" },
        "userName": { "type": "string", "description": "Name of the person leaving feedback" },
        "comment": { "type": "string", "description": "The feedback text" },
        "rating": { "type": "number", "description": "Rating from 1 to 5" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userName", "comment", "rating", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A single clothing item in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product" },
        "price": { "type": "number", "description": "Price in ₹" },
        "description": { "type": "string", "description": "A short summary of the item" },
        "imageUrl": { "type": "string", "format": "uri", "description": "Link to the product image in Storage" },
        "category": { "type": "string", "description": "Type of clothing (e.g., Saree, Suit)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "imageUrl"]
    },
    "UserImage": {
      "title": "UserImage",
      "description": "User-uploaded image records for reuse",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who uploaded the image" },
        "imageUrl": { "type": "string", "format": "uri", "description": "Link to the uploaded image" },
        "publicId": { "type": "string", "description": "Cloudinary public ID reference" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "imageUrl", "publicId", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all available products"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User reviews and ratings for products"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Authorized administrators list"
    },
    "/user_images/{imageId}": {
      "schema": "UserImage",
      "description": "Collection of user-uploaded images for reuse"
    }
  }
}
